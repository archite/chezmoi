[alias]
  amend = commit --amend --no-edit
  br = branch
  cf = clone --filter=blob:none
  cfn = clone --filter=blob:none --no-checkout
  ci = commit
  ciq = commit --allow-empty-message --no-edit
  co = checkout
  csv = log --pretty=format:\"%h,%al,%ad,%s\"
  ct = clone --filter=tree:0
  ctn = clone --filter=tree:0 --no-checkout
  dist = !f() { git clean -ffdx -e .direnv -e .envrc ${1:+${GIT_PREFIX}}${1:-:/} && git restore ${1:+${GIT_PREFIX}}${1:-:/} } f
  dt = difftool
  ff = fetch --filter=blob:none
  ft = fetch --filter=tree:0
  gc-all = -c gc.pruneExpire=now -c gc.reflogExpire=0 -c gc.reflogExpireUnreachable=0 -c gc.rerereResolved=0 -c gc.rerereUnresolved=0 gc --aggressive
  ll = log --pretty=format:\"%h: %ar - %aN <%ae> - %s\"
  merges = log --merges --first-parent --pretty=format:\"%h,%al,%ad,%s\"
  root = rev-parse --show-toplevel
  sc = !f() { git clean -ffdx -e .direnv -e .envrc ${1:+${GIT_PREFIX}}${1:-:/} } f
  sca = !f() { git sc ${1:+${GIT_PREFIX}}${1:-:/} && git submodule foreach --recursive git sc } f
  slog = log --graph --all --topo-order --pretty=format:\"%h %ai %s%d (%an)\"
  st = status
  sti = status --ignored
  suif = submodule update --init --filter=blob:none --recursive
  suit = submodule update --init --filter=tree:0 --recursive

[commit]
	gpgsign = true

[user]
	email = adam@akarsoft.com
	name = Adam Karim
	signingkey = adam@akarsoft.com
[init]
	defaultBranch = main
